# Copy to .env and adjust. Never commit the real .env.

# Server
PORT=4000
NODE_ENV=development

# MongoDB connection string
# Local install:   mongodb://127.0.0.1:27017/timegridfc
# MongoDB Atlas:   mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/timegridfc
MONGO_URI=mongodb://127.0.0.1:27017/timegridfc

# Auth
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_EXPIRES_IN=7d

# CORS — the origin the frontend is served from (comma-separated for multiple)
CLIENT_ORIGIN=http://127.0.0.1:8777,http://localhost:8777,http://127.0.0.1:4000,http://localhost:4000

# Serve the frontend from this API too (so one command runs everything).
# Set to the folder that contains index.html. Leave blank to run API-only.
CLIENT_DIR=..
